# Append this site to the existing host Caddyfile, then validate and reload Caddy.
resume-reranker.namankundra.com {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    request_body {
        max_size 260MB
    }
    reverse_proxy resume-reranker:8000
}
